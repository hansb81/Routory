<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 2026-10-19 보안 점검 DEP-03: allowBackup이 true였을 때는 adb backup/Android 자동 백업으로
         WebView의 localStorage(Supabase 세션 토큰 포함)·IndexedDB(첨부 사진)가 통째로 추출될 수 있었다. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 소셜 로그인(Supabase signInWithOAuth) 딥링크 콜백: routory://auth-callback?code=...
                 auth.js의 oauthRedirectTo()가 네이티브 앱에서 이 값을 redirectTo로 쓰고,
                 App.addListener("appUrlOpen", ...)이 받아서 code를 세션으로 바꾼다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="routory" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13(API 33)부터는 이 선언이 있어야 PushNotifications.requestPermissions()가 실제로 알림
         권한 팝업을 띄운다(targetSdk 36이라 해당). camera 권한과 달리 이건 선언을 빼도 우회할 방법이 없다 -
         런타임 알림 자체가 이 권한 없이는 OS에 의해 막힌다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
